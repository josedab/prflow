# ============================================
# PRFlow Environment Variables
# ============================================
# Copy this file to .env:  cp .env.example .env
# The defaults below let you run the API and dashboard locally
# with Docker for Postgres/Redis. No edits needed for basic exploration.

# ============================================
# Required for local development
# ============================================

# Application
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Database — matches docker/docker-compose.yml defaults
DATABASE_URL=postgresql://prflow:prflow@localhost:5432/prflow

# Redis — matches docker/docker-compose.yml defaults
REDIS_URL=redis://localhost:6379

# Session secret (must be ≥ 32 characters; change in production)
SESSION_SECRET=prflow-dev-session-secret-change-me-in-production-please

# Dashboard URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── URLs used by OAuth redirects (match the ports above) ──
# Only change these if running on a non-default host or port.
# DASHBOARD_URL=http://localhost:3000
# API_URL=http://localhost:3001

# ============================================
# GitHub App (optional for local exploration)
# ============================================
# These are only required for webhook processing and GitHub integration.
# The app starts without them — you'll see a warning in logs.
# To set up a GitHub App: https://github.com/settings/apps
# See README.md#github-app-setup for full instructions.

# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ============================================
# Optional
# ============================================

# Copilot SDK API key (enables AI-powered features)
# COPILOT_API_KEY=

# ============================================
# Multi-Provider LLM Configuration (optional)
# ============================================
# Configure one or more LLM providers. The router will select
# the best provider based on your chosen strategy.

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4-turbo-preview
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Google AI
# GOOGLE_AI_API_KEY=
# GOOGLE_AI_MODEL=gemini-pro

# Ollama (local/air-gapped)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# Routing strategy: cost-optimized, quality-optimized, latency-optimized, air-gapped
# LLM_ROUTING_STRATEGY=quality-optimized

# ============================================
# GitLab / Bitbucket Integration (optional)
# ============================================
# GITLAB_ACCESS_TOKEN=
# GITLAB_BASE_URL=https://gitlab.com/api/v4

# BITBUCKET_ACCESS_TOKEN=
# BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
